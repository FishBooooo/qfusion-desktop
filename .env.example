# M0 development-only configuration. Never place real secrets in this file.
QFUSION_ENVIRONMENT=development
QFUSION_HOST=127.0.0.1
QFUSION_PORT=8000
QFUSION_LLM_MODE=off

# The production desktop app will use a per-session token generated at runtime.
# Do not commit a real session token.
QFUSION_SESSION_TOKEN=

VITE_API_BASE_URL=http://127.0.0.1:8000
