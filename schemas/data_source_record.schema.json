{
  "$defs": {
    "JsonValue": {},
    "QualityFlag": {
      "description": "Explicit quality state for one source record.",
      "enum": [
        "OK",
        "DELAYED",
        "STALE",
        "CONFLICT",
        "MISSING",
        "SYNTHETIC_MOCK"
      ],
      "title": "QualityFlag",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Traceable wrapper around one vendor-neutral financial fact.",
  "properties": {
    "adjustment_type": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Adjustment Type"
    },
    "available_at": {
      "format": "date-time",
      "title": "Available At",
      "type": "string"
    },
    "dataset_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Dataset Version",
      "type": "string"
    },
    "effective_from": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Effective From"
    },
    "effective_to": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Effective To"
    },
    "event_time": {
      "format": "date-time",
      "title": "Event Time",
      "type": "string"
    },
    "fact_id": {
      "format": "uuid",
      "title": "Fact Id",
      "type": "string"
    },
    "fact_type": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Fact Type",
      "type": "string"
    },
    "ingested_at": {
      "format": "date-time",
      "title": "Ingested At",
      "type": "string"
    },
    "instrument_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Instrument Id"
    },
    "is_adjusted": {
      "default": false,
      "title": "Is Adjusted",
      "type": "boolean"
    },
    "license_scope": {
      "maxLength": 128,
      "minLength": 1,
      "title": "License Scope",
      "type": "string"
    },
    "payload": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Payload",
      "type": "object"
    },
    "provider_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Provider Version",
      "type": "string"
    },
    "published_at": {
      "format": "date-time",
      "title": "Published At",
      "type": "string"
    },
    "quality_flag": {
      "$ref": "#/$defs/QualityFlag"
    },
    "raw_payload_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Raw Payload Hash",
      "type": "string"
    },
    "received_at": {
      "format": "date-time",
      "title": "Received At",
      "type": "string"
    },
    "revision_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Revision Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^1\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "source_quality_level": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Source Quality Level",
      "type": "string"
    },
    "source_record_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Source Record Id",
      "type": "string"
    },
    "venue_scope": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Venue Scope",
      "type": "string"
    }
  },
  "required": [
    "fact_id",
    "fact_type",
    "source",
    "source_record_id",
    "source_quality_level",
    "venue_scope",
    "license_scope",
    "provider_version",
    "dataset_version",
    "event_time",
    "published_at",
    "available_at",
    "received_at",
    "ingested_at",
    "revision_id",
    "quality_flag",
    "raw_payload_hash"
  ],
  "title": "DataSourceRecord",
  "type": "object"
}
